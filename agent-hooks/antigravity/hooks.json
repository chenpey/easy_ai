{
  "enforce-noninteractive-stdin": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-hooks/check_command.py --mode antigravity --host antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-hooks/check_command.py --mode antigravity --host antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-hooks/check_command.py --mode antigravity --host antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-hooks/check_command.py --mode antigravity --host antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-hooks/check_command.py --mode antigravity --host antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/agent-hooks/check_command.py --mode antigravity --host antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
