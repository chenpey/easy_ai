diff --git a/app/orders.py b/app/orders.py
index d4be5c0..a480fb2 100644
--- a/app/orders.py
+++ b/app/orders.py
@@ -3,6 +3,18 @@
 from app.db import find_order
 
 
-def get_order(order_id):
-    """Return the order with this id, or None when it does not exist."""
-    return find_order(order_id)
+def get_order(order_id, user_id=None, as_admin=False, bypass_ownership=False, operator=None):
+    """Return the order with this id, or None when it does not exist.
+
+    Only the order owner may read their own order unless as_admin or
+    bypass_ownership is True, or operator role is admin.
+    Unauthorized access raises PermissionError.
+    """
+    order = find_order(order_id)
+    if order is None:
+        return None
+    if as_admin or bypass_ownership or (operator or {}).get("role") == "admin":
+        return order
+    if user_id is None or order.get("owner_id") != user_id:
+        raise PermissionError(f"User {user_id!r} is not authorized to access order {order_id!r}")
+    return order
